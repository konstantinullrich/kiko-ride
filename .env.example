# Copy to .env and fill in. Values are read literally by docker: no quotes.

# Required. BIP-39 mnemonic of the server cosigner keys; whoever has it
# controls the server's share of every ride wallet.
KIKO_SERVER_MNEMONIC=
# Required. Mapbox token for geocoding.
MAPBOX_ACCESS_TOKEN=

# Chain backend for payouts: Koios. KOIOS_URL defaults to the public
# instance for CARDANO_NETWORK; KOIOS_API_TOKEN is optional.
KOIOS_URL=
KOIOS_API_TOKEN=

# Optional: accept BSV by setting an ARC endpoint, including /v1, e.g.
# https://arc.gorillapool.io/v1 (mainnet). BSV runs on mainnet with
# CARDANO_NETWORK=mainnet, otherwise on testnet. The built-in facilitator
# verifies rider payments; BSV_FACILITATOR_URL replaces it with an external one.
BSV_ARC_URL=
BSV_ARC_API_KEY=
BSV_FACILITATOR_URL=

# preprod (default), preview or mainnet. The built-in facilitator verifies
# ADA payments and settles them through Koios; ADA_FACILITATOR_URL replaces
# it with an external one.
CARDANO_NETWORK=preprod
ADA_FACILITATOR_URL=

KIKO_LISTEN_ADDR=:8080
# SQLite database of drivers and rides; each ride's address index comes from
# it, so keep it: a new database hands out the same indexes again.
KIKO_DB_PATH=kiko.db
MAPBOX_PERMANENT=false
